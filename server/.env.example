# Masar AI Backend Environment Blueprint
PORT=8080
NODE_ENV=production
GOOGLE_CLOUD_PROJECT=masar-ai-504916
GOOGLE_CLOUD_LOCATION=global
GOOGLE_GENAI_USE_VERTEXAI=true
FRONTEND_ORIGINS=http://localhost:3000,http://localhost:5173,https://masar-ai-frontend-828667104263.us-west4.run.app

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Optional Local Gemini API key fallback
GEMINI_API_KEY=

# Google OAuth 2.0 Credentials (Gmail Integration)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=https://masar-ai-backend-828667104263.us-west4.run.app/api/gmail/callback

# Google Cloud Storage Bucket (Resume PDFs/DOCX)
GCS_BUCKET_NAME=

# External Live Job Provider API Key
LIVE_JOB_PROVIDER_API_KEY=

# Telegram Bot API Token (Server-Side Delivery)
TELEGRAM_BOT_TOKEN=
